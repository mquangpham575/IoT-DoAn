# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# API security
IOT_API_KEY=IOT_SECRET_2026
REQUIRE_API_KEY=true

# Discord alert
ENABLE_DISCORD_ALERT=false
DISCORD_WEBHOOK_URL=
