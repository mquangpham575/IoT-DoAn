# MQTT
ENABLE_MQTT=true
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC=iot/+/sensor
MQTT_CLIENT_ID=iot-health-backend
MQTT_USERNAME=
MQTT_PASSWORD=
